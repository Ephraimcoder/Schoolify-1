{
  "expo": {
    "androidNavigationBar": {
      "visible": "immersive",
      "backgroundColor": "#00000000"
    },
    "name": "Schoolify",
    "slug": "Schoolify1",
    "version": "1.0.0",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "icon": "./assets/images/Schoolify main logo.png",
    "scheme": ["schoolify"],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/Schoolify main logo.png",
        "backgroundColor": "#d6cbb8"
      },
      "edgeToEdgeEnabled": false,
      "package": "com.ephraimcoder.Schoolify",
      "jsEngine": "hermes",
      "newArchEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/Schoolify main logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "@lovesworking/watermelondb-expo-plugin-sdk-52-plus",
        {
          "jscFlavor": "android-jsc-intl"
        }
      ],

      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Schoolify main logo.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#d6cbb8"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "2.0.21",
            "packagingOptions": {
              "pickFirst": ["**/libc++_shared.so"]
            }
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be36c56d-4cc6-4068-ab56-b0ed27cef796"
      }
    },
    "owner": "ephraimcoder"
  }
}
